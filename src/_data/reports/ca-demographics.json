  "methods": [
    {
      "title": "Source.",
      "text": "U.S. Census Bureau American Community Survey 2020-2024 5-year estimates, released December 2025. ZIP codes are 2020 Census ZIP Code Tabulation Areas."
    },
    {
      "title": "Coverage.",
      "text": "1,803 populated California ZIP codes. PO box ZIP codes have no residents and no Census profile. Traffic from them belongs to the surrounding ZIP code."
    },
    {
      "title": "Precision.",
      "text": "Every value carries an ACS margin of error and is most reliable for larger ZIP codes. The Census top-codes income at \"$250,000 or more\". A blank value means the Census did not publish it, never zero."
    },
    { "title": "Regions.", "text": "Region figures are household-weighted averages of ZIP code values." },
    {
      "title": "Fire tier.",
      "text": "The prime target screen uses the composite brush fire tier from the <a href=\"/ca/brush-fire-risk\">California Brush Fire Risk</a> report, built from the FEMA National Risk Index (December 2025)."
    }
  ]
