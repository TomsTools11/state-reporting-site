<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.name }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.tagline }}{% endblock %}">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/site.css">
{% block head %}{% endblock %}
<link rel="stylesheet" href="/assets/css/print.css" media="print">
</head>
<body>
<div class="shell">
  <aside class="side">
    <a class="brand" href="/"><img class="logo" src="/assets/brand/goal-wordmark-white.png" width="720" height="193" alt="GOAL"></a>
    {% block side %}{% endblock %}
    <div class="foot">{% block sidefoot %}{{ site.name }}. {{ site.tagline }}{% endblock %}</div>
  </aside>
  <main class="main" id="main">
    <div class="print-head" aria-hidden="true">
      <img src="/assets/brand/goal-wordmark-black.png" width="720" height="193" alt="">
      <div>{% block printhead %}<p class="pt-title">{{ site.name }}</p>{% endblock %}</div>
    </div>
    {% block content %}{% endblock %}
  </main>
</div>
{% block scripts %}{% endblock %}
</body>
</html>
