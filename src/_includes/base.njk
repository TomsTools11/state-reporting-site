<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site.name }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ site.tagline }}{% endblock %}">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#080c10">
<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/Sora-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/Outfit-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/tokens.css">
<link rel="stylesheet" href="/assets/css/site.css">
{% block head %}{% endblock %}
<link rel="stylesheet" href="/assets/css/print.css" media="print">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap hdr">
    <a class="brand-link" href="/" aria-label="{{ site.name }} home">
      <img class="brand-logo" src="/assets/brand/goal-wordmark-white.png" width="720" height="193" alt="GOAL">
      <span class="brand-name">State Reports</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>All Reports</a>
      {%- for st in library %}
      {%- set stUrl = "/" + st.id + "/" %}
      <a href="/{{ st.id }}"{% if page.url == stUrl %} aria-current="page"{% elif page.url.startsWith(stUrl) %} aria-current="true"{% endif %}>{{ st.name }}</a>
      {%- endfor %}
      <a href="/#how">How Reports Are Built</a>
    </nav>
    {%- if site.cta and site.cta.url %}
    <a class="btn btn-primary" href="{{ site.cta.url }}">{{ site.cta.label }}</a>
    {%- endif %}
  </div>
</header>
<main id="main">
  <div class="print-head" aria-hidden="true">
    <img src="/assets/brand/goal-wordmark-black.png" width="720" height="193" alt="">
    <div>{% block printhead %}<p class="pt-title">{{ site.name }}</p>{% endblock %}</div>
  </div>
  {% block content %}{% endblock %}
</main>
<footer class="site-footer">
  <div class="rule" aria-hidden="true"></div>
  <div class="wrap ftr">
    <div>
      <img class="brand-logo" src="/assets/brand/goal-wordmark-white.png" width="720" height="193" alt="GOAL">
      <p>{{ site.tagline }}</p>
    </div>
    <nav aria-label="Footer">
      <a href="/">All Reports</a>
      {%- for st in library %}
      <a href="/{{ st.id }}">{{ st.name }}</a>
      {%- endfor %}
      <a href="/#how">How Reports Are Built</a>
    </nav>
  </div>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
